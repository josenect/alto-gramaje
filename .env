# ------------------------------------------------------------------------------
# ALTO GRAMAJE - datos del negocio
#
# ESTE ES EL UNICO SITIO CON DATOS DEL NEGOCIO. Lo leen las tres partes del
# proyecto: la web, el crawler de Drive y el generador del catalogo.
#
# Para cambiar algo: editar aqui, confirmar el cambio (commit) y subirlo. Netlify
# recompila solo y en un par de minutos esta en vivo.
#
# Este archivo SI va al repositorio, al contrario de lo habitual con los .env: no
# hay ningun secreto, todo esto se ve en la propia web.
#
# Lo unico que NO esta aqui son el logo y los iconos, porque son imagenes: se
# cambian reemplazando public/logo.png, icon-180.png e icon-512.png.
#
# Detalle completo en CONFIGURACION.md.
# ------------------------------------------------------------------------------

# Numero que recibe los pedidos. Se puede escribir como sea ("+57 322 814 3410",
# "322-814-3410"): la web le quita todo lo que no sea digito.
VITE_WHATSAPP="573228143410"

# Nombre del negocio. Sale en el pie, en el mensaje de WhatsApp, en el titulo de
# la pestana y en las etiquetas que leen Google y WhatsApp al compartir el enlace.
VITE_STORE="Alto Gramaje"

# Frase pequena junto al logo, en la cabecera. En movil no cabe y solo se ve en
# escritorio: el logo es casi cuadrado y ocupa ese hueco.
VITE_TAGLINE="Envíos a todo el país"

# Texto que leen Google y WhatsApp al compartir el enlace de la web.
VITE_DESCRIPCION="Catálogo de Alto Gramaje: camisetas, buzos, gorras, sudaderas, dama y niño. Mira las tallas disponibles y pide por WhatsApp."

# Como se llama en la web lo que hay en el primer nivel del Drive. Aqui son
# categorias (BUZOS, COLECCION, DAMA...).
VITE_GRUPO="Categoría"

# Carpeta de Google Drive con las fotos. Es el trozo final de su URL:
#   https://drive.google.com/drive/folders/<VITE_DRIVE_FOLDER>
# Tiene que estar compartida como "cualquiera con el enlace".
VITE_DRIVE_FOLDER="1BssKlb8t1B4NHaIdTAKndXFJJGbvdNEW"

# Como se decide que dos fotos son el mismo producto en distintas tallas.
#   "nombre"    : mismo nombre de archivo en varias carpetas TALLA. Es el caso de
#                 este Drive: cada foto lleva un codigo (050aa21c-...jpg) que se
#                 repite igual en cada talla (comprobado: misma imagen).
#   "contenido" : misma imagen, comparando las fotos. Hace falta cuando el nombre
#                 no identifica el producto (ver Visionary).
# No es de la web: lo lee solo el generador del catalogo (scripts/build.py).
CATALOGO_AGRUPAR="nombre"

# Enlaces de la cabecera: el punto fisico y las redes. DEJAR VACIA UNA DE ESTAS
# ESCONDE SU ICONO, asi que si manana no hay TikTok basta con vaciar la linea.
# Ojo: este enlace de Maps es una vista de calle en Bucaramanga, no la ficha de la
# tienda. Si la tienda tiene ficha propia en Google Maps, mejor el enlace de esa ficha.
VITE_MAPS="https://maps.app.goo.gl/YyYSBxeYbmeeLj74A"
# Texto al lado del pin, para que se entienda que es la tienda fisica y no otra red. Corto:
# la ciudad o el barrio. Vacio deja solo el icono.
VITE_MAPS_LABEL="Bucaramanga"
VITE_INSTAGRAM="https://www.instagram.com/altogramaje_twin/"
VITE_TIKTOK="https://www.tiktok.com/@alto.gramaje"
VITE_FACEBOOK="https://www.facebook.com/profile.php?id=61582199687829"

# Cuantos productos se muestran por pagina.
VITE_PER_PAGE="48"

# Viendo el catalogo completo, cuantos productos seguidos de la misma categoria antes
# de pasar a la siguiente. Bajarlo a 1 alterna producto a producto.
VITE_POR_CATEGORIA="2"

# El dominio del sitio, para las vistas previas al compartir. En Netlify se
# rellena solo desde $URL; solo hace falta tocarlo con un dominio propio.
# VITE_SITE_URL="https://alto-gramaje.netlify.app"
